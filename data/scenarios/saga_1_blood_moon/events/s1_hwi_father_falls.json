{
  "id": "s1_hwi_father_falls",
  "title": "아버지의 검",
  "description": "혈월의 밤, 남궁천이 동쪽 진에서 쓰러졌습니다. 마지막 순간까지 아들의 이름을 불렀다고 합니다.\n당신의 손에 아버지의 검이 남았습니다.",
  "can_repeat": false,
  "priority": true,
  "weight": 10,
  "npc": "npc_namgung_enforcer",
  "conditions": [
    {
      "type": "scenario",
      "in": [
        "saga_1_blood_moon"
      ]
    },
    {
      "type": "flag",
      "flag": "playing_npc_rival",
      "value": true
    },
    {
      "type": "turns_since_flag",
      "flag": "s1_blood_night",
      "op": ">=",
      "value": 1
