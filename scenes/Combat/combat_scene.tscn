[gd_scene load_steps=2 format=3 uid="uid://combat_scene"]

[ext_resource type="Script" path="res://scripts/Combat/combat_controller.gd" id="1_combat"]

[node name="CombatScene" type="Node2D"]
script = ExtResource("1_combat")

[node name="Background" type="ColorRect" parent="."]
offset_right = 1280.0
offset_bottom = 720.0
color = Color(0.08, 0.1, 0.14, 1)

[node name="GridOverlay" type="Node2D" parent="."]

[node name="UnitsLayer" type="Node2D" parent="."]

[node name="HUD" type="CanvasLayer" parent="."]

[node name="Panel" type="PanelContainer" parent="HUD"]
offset_left = 790.0
offset_top = 16.0
offset_right = 1264.0
offset_bottom = 680.0

[node name="VBox" type="VBoxContainer" parent="HUD/Panel"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="TitleLabel" type="Label" parent="HUD/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "전술 전투"

[node name="TerrainLabel" type="Label" parent="HUD/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "지형"
autowrap_mode = 3

[node name="RoundLabel" type="Label" parent="HUD/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "라운드 1"

[node name="TurnLabel" type="Label" parent="HUD/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "현재 턴"

[node name="PlayerHPLabel" type="Label" parent="HUD/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "HP"

[node name="EnemyHPLabel" type="Label" parent="HUD/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "적 HP"

[node name="APLabel" type="Label" parent="HUD/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "행동력"

[node name="MartialLabel" type="Label" parent="HUD/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "무공"

[node name="ModeRow" type="HBoxContainer" parent="HUD/Panel/VBox"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="ModeMoveButton" type="Button" parent="HUD/Panel/VBox/ModeRow"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_horizontal = 3
text = "이동 (M)"

[node name="ModeAttackButton" type="Button" parent="HUD/Panel/VBox/ModeRow"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_horizontal = 3
text = "공격 (A)"

[node name="UndoMoveButton" type="Button" parent="HUD/Panel/VBox/ModeRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_horizontal = 3
disabled = true
text = "이동 취소 (Z)"

[node name="ArtList" type="VBoxContainer" parent="HUD/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4

[node name="TurnRow" type="HBoxContainer" parent="HUD/Panel/VBox"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="EndTurnButton" type="Button" parent="HUD/Panel/VBox/TurnRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_horizontal = 3
text = "턴 종료 (Space)"

[node name="BackButton" type="Button" parent="HUD/Panel/VBox/TurnRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_horizontal = 3
text = "문파로 돌아가기"

[node name="LogLabel" type="Label" parent="HUD/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
text = "전투 로그"
autowrap_mode = 3

[connection signal="pressed" from="HUD/Panel/VBox/ModeRow/ModeMoveButton" to="." method="_on_mode_move_pressed"]
[connection signal="pressed" from="HUD/Panel/VBox/ModeRow/ModeAttackButton" to="." method="_on_mode_attack_pressed"]
[connection signal="pressed" from="HUD/Panel/VBox/ModeRow/UndoMoveButton" to="." method="_on_undo_move_pressed"]
[connection signal="pressed" from="HUD/Panel/VBox/TurnRow/EndTurnButton" to="." method="_on_end_turn_pressed"]
[connection signal="pressed" from="HUD/Panel/VBox/TurnRow/BackButton" to="." method="_on_back_pressed"]