[gd_scene load_steps=2 format=3 uid="uid://sect_war_screen"]

[ext_resource type="Script" path="res://scripts/UI/sect_war_screen.gd" id="1_war"]

[node name="SectWarScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_war")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.1, 0.08, 0.08, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 32

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "문파전 지휘 — 남궁세가"

[node name="PowerLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "아군 전력"

[node name="RoundLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "지휘 명령: 0 / 3"

[node name="HelpLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "3라운드 동안 지휘 명령을 선택하세요. 상성에 따라 전세가 바뀝니다."
autowrap_mode = 3

[node name="CommandGrid" type="GridContainer" parent="Margin/VBox"]
layout_mode = 2
columns = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8

[node name="ChargeButton" type="Button" parent="Margin/VBox/CommandGrid"]
