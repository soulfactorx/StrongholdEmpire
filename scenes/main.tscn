[gd_scene load_steps=2 format=3 uid="uid://main_menu_scene"]

[ext_resource type="Script" path="res://scripts/UI/main_menu.gd" id="1_main"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.08, 0.1, 0.14, 1)

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TitleLabel" type="Label" parent="CenterContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 48
text = "강호제패"
horizontal_alignment = 1

[node name="SubtitleLabel" type="Label" parent="CenterContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "무협 전략 시뮬레이션 RPG"
horizontal_alignment = 1

[node name="StatusLabel" type="Label" parent="CenterContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "상태"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="CenterContainer/VBox"]
custom_minimum_size = Vector2(0, 16)
layout_mode = 2

[node name="ContinueButton" type="Button" parent="CenterContainer/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 48)
layout_mode = 2
text = "계속하기"

[node name="NewGameButton" type="Button" parent="CenterContainer/VBox"]
custom_minimum_size = Vector2(320, 48)
layout_mode = 2
text = "새 게임"

[node name="LoadButton" type="Button" parent="CenterContainer/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 48)
layout_mode = 2
text = "불러오기"

[node name="OptionsButton" type="Button" parent="CenterContainer/VBox"]
custom_minimum_size = Vector2(320, 48)
layout_mode = 2
text = "설정"

[node name="HelpButton" type="Button" parent="CenterContainer/VBox"]
custom_minimum_size = Vector2(320, 48)
layout_mode = 2
text = "플레이 가이드"

[node name="QuitButton" type="Button" parent="CenterContainer/VBox"]
custom_minimum_size = Vector2(320, 48)
layout_mode = 2
text = "종료"

[node name="DevToggleButton" type="Button" parent="CenterContainer/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 32)
layout_mode = 2
text = "개발자 메뉴 ▼"

[node name="DevPanel" type="PanelContainer" parent="CenterContainer/VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="DevVBox" type="GridContainer" parent="CenterContainer/VBox/DevPanel"]
layout_mode = 2
columns = 3
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 6

[node name="DevManagementButton" type="Button" parent="CenterContainer/VBox/DevPanel/DevVBox"]
custom_minimum_size = Vector2(150, 32)
layout_mode = 2
text = "문파 경영"

[node name="DevMartialArtButton" type="Button" parent="CenterContainer/VBox/DevPanel/DevVBox"]
custom_minimum_size = Vector2(150, 32)
layout_mode = 2
text = "무공 연구"

[node name="DevCombatButton" type="Button" parent="CenterContainer/VBox/DevPanel/DevVBox"]
custom_minimum_size = Vector2(150, 32)
layout_mode = 2
text = "1:1 결투"

[node name="DevSectWarButton" type="Button" parent="CenterContainer/VBox/DevPanel/DevVBox"]
custom_minimum_size = Vector2(150, 32)
layout_mode = 2
text = "문파전 지휘"

[node name="DevEndingButton" type="Button" parent="CenterContainer/VBox/DevPanel/DevVBox"]
custom_minimum_size = Vector2(150, 32)
layout_mode = 2
text = "엔딩 / 레거시"

[node name="DevGridButton" type="Button" parent="CenterContainer/VBox/DevPanel/DevVBox"]
custom_minimum_size = Vector2(150, 32)
layout_mode = 2
text = "그리드 이동 데모"

