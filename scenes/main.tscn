[connection signal="pressed" from="CenterContainer/VBox/SaveHBox/SaveButton" to="." method="_on_save_pressed"]
[connection signal="pressed" from="CenterContainer/VBox/SaveHBox/LoadButton" to="." method="_on_load_pressed"]
[connection signal="pressed" from="CenterContainer/VBox/GridButton" to="." method="_on_grid_demo_pressed"]
[connection signal="pressed" from="CenterContainer/VBox/QuitButton" to="." method="_on_quit_pressed"]